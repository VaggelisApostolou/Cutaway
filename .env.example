# Copy to .env (never commit .env). Leave blank what you don't use.

# auto | gemini | azure | offline   (auto: azure if configured, else gemini, else offline)
CUTAWAY_LLM_PROVIDER=auto

# Google Gemini API free tier (aistudio.google.com > Get API key). Never set up billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Microsoft Foundry / Azure OpenAI deployment
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5.4-mini

# Azure AI Speech (voice-over, free F0 tier)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
