# Copy to .env (never commit .env). Leave blank what you don't use.

# auto | github | azure | offline   (auto: azure if configured, else github, else offline)
CUTAWAY_LLM_PROVIDER=auto

# GitHub Models (free, rate limited): fine-grained token with "Models: read-only"
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Microsoft Foundry / Azure OpenAI deployment
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5.4-mini

# Azure AI Speech (voice-over, free F0 tier)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
